# Files uploaded to Vercel are served publicly as static assets.
# Only the site itself may be uploaded — nothing from the repository that is not a web page.
# Everything else here belongs to the project, not to the website.
.env*
.git
.gitignore
.gitmodules
.editorconfig
.github/
LOCAL/
contracts/
scripts/
# The artwork the site's marks were cut from, and the draft cuts taken while choosing between them:
# kept on disk, never served. The deploy uploads this directory rather than a git tree, so an
# uncommitted file is a published file unless it is named here.
assets/logo.jpg
assets/*-test.png
*.md
LICENSE
# the local static server's log and pid, if one is running while a deploy happens
.serve.log
.serve.pid
